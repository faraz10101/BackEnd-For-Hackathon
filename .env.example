PORT=5000
# Database name must be Scam-Shield-database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/Scam-Shield-database?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain you verified in Resend
EMAIL_FROM=ScamShield <noreply@your-domain.com>
APP_NAME=ScamShield
EMAIL_LOGO_URL=
COOKIE_SAMESITE=

# Long random strings. Keep ENCRYPTION_SECRET stable: it encrypts the AI keys stored in the DB.
ENCRYPTION_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-to-another-long-random-string
SALT=change-me-random-salt-for-reporter-hash
CLIENT_ORIGIN=http://localhost:5173
ALLOW_REPEAT_REPORTS=false

# ============================================================================
# AI PROVIDERS. Just paste keys here. The server loads them by itself on every start
# (no extra command). If one provider hits its limit or fails, the next one answers.
# Lower priority is tried first: gemini (1) -> groq (5) -> openrouter (8)
# Need more keys of the same provider? Add _2, _3, _4, _5 (each key has its own free limit).
# ============================================================================
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=

# Optional: change model names if one stops working (models get renamed over time)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: add ANY other OpenAI-compatible provider (n = 1..9)
# AI_PROVIDER_1_NAME=together
# AI_PROVIDER_1_TYPE=openai
# AI_PROVIDER_1_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# AI_PROVIDER_1_BASE_URL=https://api.together.xyz/v1
# AI_PROVIDER_1_KEY=
# AI_PROVIDER_1_PRIORITY=6

# ============================================================================
# DAILY WEB RESEARCH (needs a Gemini key). More settings: config/ai.config.js
# ============================================================================
# RESEARCH_ENABLED=true
# RESEARCH_HOUR_PKT=6
# RESEARCH_MAX_ALERTS=5

# Only if your network cannot resolve the mongodb+srv:// address (DNS error ENOTFOUND / ECONNREFUSED):
# DNS_SERVERS=8.8.8.8,8.8.4.4
# Set to production on Render / Railway so the login cookie is Secure + SameSite=None
# NODE_ENV=production

# ============================================================================
# LIVE SEARCH (homepage "What is happening right now?")
#   auto   = news headlines (free, any AI provider writes the answer) -> Gemini web search as backup  (default)
#   news   = news headlines only      gemini = Gemini web search only
# ============================================================================
# LIVE_SEARCH_MODE=auto
# LIVE_SEARCH_DAILY_LIMIT=5
